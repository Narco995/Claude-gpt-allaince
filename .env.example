# --- Provider credentials (never commit real values) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional base URL overrides (proxies, Azure/OpenAI-compatible gateways, test doubles)
ANTHROPIC_BASE_URL=
OPENAI_BASE_URL=

# --- Default models ---
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_MODEL=gpt-4.1

# --- Bridge server ---
PORT=8787
HOST=0.0.0.0
# Backward-compatible single identity. Prefer BRIDGE_AUTH_TOKENS_JSON for separate human/agent identities.
BRIDGE_API_KEY=
BRIDGE_API_PRINCIPAL_ID=human:operator
# Default scopes for BRIDGE_API_KEY; use least privilege instead of "*" in production.
BRIDGE_API_SCOPES=*
# Optional multi-identity JSON; each token must be at least 16 characters.
# Example: [{"id":"human:operator","token":"REPLACE_WITH_LONG_RANDOM_SECRET","scopes":["admin"]},{"id":"agent:claude-director","token":"REPLACE_WITH_DIFFERENT_SECRET","scopes":["workflow:run","workflow:read","workflow:critique","session:read","session:write","tool:call","model:list"]}]
BRIDGE_AUTH_TOKENS_JSON=
# Persistent single-replica state directory. Mount this path as a durable volume.
BRIDGE_STATE_DIR=./data
# Comma-separated allowed browser origins (empty = none). Protects MCP HTTP from DNS-rebinding/CSRF.
ALLOWED_ORIGINS=

# --- Resilience ---
REQUEST_TIMEOUT_MS=60000
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=500
MAX_TOOL_ROUNDS=6
WORKFLOW_TIMEOUT_MS=300000
MAX_CONCURRENT_WORKFLOWS=10

# --- Sessions ---
SESSION_TTL_MS=3600000
MAX_SESSIONS=1000

LOG_LEVEL=info
NODE_ENV=development
