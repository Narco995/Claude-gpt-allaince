# --- Provider credentials (never commit real values) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional base URL overrides (proxies, Azure/OpenAI-compatible gateways, test doubles)
ANTHROPIC_BASE_URL=
OPENAI_BASE_URL=

# --- Default models ---
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_MODEL=gpt-4.1

# --- Bridge server ---
PORT=8787
HOST=0.0.0.0
# Bearer token required on /mcp and /api/* when set. REQUIRED when NODE_ENV=production.
BRIDGE_API_KEY=
# Comma-separated allowed browser origins (empty = none). Protects MCP HTTP from DNS-rebinding/CSRF.
ALLOWED_ORIGINS=

# --- Resilience ---
REQUEST_TIMEOUT_MS=60000
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=500
MAX_TOOL_ROUNDS=6
WORKFLOW_TIMEOUT_MS=300000

# --- Sessions ---
SESSION_TTL_MS=3600000
MAX_SESSIONS=1000

LOG_LEVEL=info
NODE_ENV=development
